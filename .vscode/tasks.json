{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate Agent Environment",
      "type": "shell",
      "command": "${workspaceFolder}/agent/.venv/Scripts/python.exe -c \"import debugpy, sys; print('agent-debug-ready')\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Groupware Agent",
      "type": "shell",
      "command": "${workspaceFolder}/agent/.venv/Scripts/python.exe -m debugpy --listen 127.0.0.1:5679 agent/agent.py --prompt \"Summarize the current workspace and suggest three useful tasks.\"",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Validate Agent Environment"
      ],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|[Rr]unning on|Started server process"
        }
      }
    }
  ]
}
