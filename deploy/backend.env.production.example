# VPS 用の backend/.env の見本。SECRET_KEY と FRONTEND_ORIGIN を必ず書き換える
# SECRET_KEY の作り方: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:////var/lib/groupware/app.db
SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-STRING
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://example.com
# 全員の登録が済んだら false にして、新規登録を止める(最初の 1 人以外は 403)
ALLOW_REGISTRATION=true
